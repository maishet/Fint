{
  "name": "finanzas-mobilev2",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-expo-router.mjs",
    "generate:emoji-index": "bun run scripts/generate-emoji-index.ts",
    "upgrade:tamagui": "bunx npm-check-updates -u '*tamagui*' '@tamagui/*' && bun install",
    "start": "bunx expo start -c",
    "android": "bunx expo run:android",
    "build:preview:android": "bunx eas-cli build --platform android --profile preview --non-interactive",
    "build:production:android": "bunx eas-cli build --platform android --profile production --non-interactive",
    "ios": "bunx expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:coverage": "bun test --coverage tests/unit",
    "test:release": "bun run typecheck && bun run test:coverage",
    "sentry:privacy-test": "bun test tests/unit/sentry-privacy.test.ts"
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.87.0",
    "@tamagui/colors": "^2.4.0",
    "@tamagui/config": "^2.4.0",
    "@tamagui/lucide-icons-2": "^2.4.0",
    "@tamagui/themes": "^2.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.90.12",
    "babel-preset-expo": "~55.0.0",
    "burnt": "^0.12.2",
    "currency-codes": "^2.2.0",
    "expo": "~55.0.28",
    "expo-application": "~55.0.17",
    "expo-auth-session": "~55.0.17",
    "expo-build-properties": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.16",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.17",
    "expo-notifications": "~55.0.25",
    "expo-print": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.20",
    "i18next": "^25.7.2",
    "react": "19.2.0",
    "react-i18next": "^16.4.0",
    "react-native": "0.83.10",
    "react-native-calendars": "1.1314.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "rn-emoji-keyboard": "1.7.0",
    "sonner-native": "^0.26.4",
