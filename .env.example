EXPO_PUBLIC_API_URL=https://tu-backend-render.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-public-domain.com/privacy
EXPO_PUBLIC_TERMS_URL=https://your-public-domain.com/terms
EXPO_PUBLIC_FEATUREBASE_URL=https://organization.featurebase.app
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=dev

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Obligatorio para builds de iOS. Google Cloud Console > Credentials > OAuth client ID
# de tipo iOS con el bundle id com.fint.finanzasmobilev2.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Opcional: app.config.js lo deriva invirtiendo EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID.
# Definirlo solo para forzar un valor distinto al derivado.
GOOGLE_IOS_URL_SCHEME=

# Sentry queda desactivado si EXPO_PUBLIC_SENTRY_DSN esta vacio.
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/your-project-id
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
