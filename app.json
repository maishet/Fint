{
  "expo": {
    "name": "My Fint",
    "slug": "finanzas-mobilev2",
    "version": "2.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finanzasmobilev2",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFC629",
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/33804127-fd92-4847-a1fb-e9b61f2683bb"
    },
    "ios": {
      "bundleIdentifier": "com.fint.finanzasmobilev2",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": ["es", "en", "pt"]
      },
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      }
    },
    "android": {
      "package": "com.fint.finanzasmobilev2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FFC629"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite que My Fint use Face ID para proteger tus datos financieros guardados en el dispositivo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#FFC629",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#0F0F0D"
          }
        }
      ],
      ["./plugins/withNightWindowBackground", { "color": "#0F0F0D" }],
      "./plugins/withAndroidFreeOrientation",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFC629"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "finanzas-app-1x",
          "project": "fint-mobile",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "autoUploadProguardMapping": true,
            "uploadNativeSymbols": false,
            "autoUploadNativeSymbols": false,
            "includeNativeSources": false
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "My Fint necesita acceso a tus fotos para importar constancias de pago desde la galería.",
          "cameraPermission": "My Fint necesita acceso a la cámara para fotografiar constancias de pago."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "My Fint usa tu ubicación solo cuando eliges agregarla a un movimiento, para guardar dónde ocurrió."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["image/*"],
          "androidMultiIntentFilters": ["image/*"],
          "disableIOS": true
        }
      ]
    ],
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33804127-fd92-4847-a1fb-e9b61f2683bb"
      }
    },
    "owner": "maishet"
  }
}
